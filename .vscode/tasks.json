{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docs: serve Docsify",
      "type": "npm",
      "script": "docs:serve",
      "isBackground": true,
      "problemMatcher": {
        "owner": "docsify",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Listening at|Serving)"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
