{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Sandkit API",
  "entryPoints": [
    "../src/shared/asset.d.ts",
    "../src/shared/engine.d.ts",
    "../src/shared/jsonvalue.d.ts",
    "../src/shared/nominal.d.ts",
    "../src/shared/player.d.ts",
    "../src/configs/index.d.ts",
    "../src/sandkit/index.d.ts",
    "../src/sandkit/api/index.d.ts",
    "../src/sandkit/enums/index.d.ts",
    "../src/sandkit/react.d.ts",
    "../src/worker/index.d.ts",
    "../src/sandkit/engine/index.d.ts"
  ],
  "entryPointStrategy": "resolve",
  "tsconfig": "../tsconfig.json",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "../README.md",
  "out": "../docs/api",
  "excludePrivate": true,
  "excludeInternal": false,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "fileExtension": ".md",
  "entryFileName": "README.md",
  "sort": ["source-order"],
  "categorizeByGroup": true,
  "membersWithOwnFile": ["Class", "Enum"],
  "expandParameters": true,
  "indexFormat": "list",
  "gitRevision": "main",
  "validation": {
    "notDocumented": false,
    "invalidLink": false
  }
}
