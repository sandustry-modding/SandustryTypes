{
  "include": ["./src/**/*.d.ts"],
  "exclude": ["./src/worker/global.d.ts"],
  "compilerOptions": {
    "rootDir": "./src",
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": false,
    "strict": true,
    "types": ["react"],
    "forceConsistentCasingInFileNames": true
  }
}
